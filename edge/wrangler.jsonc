{
  "name": "dofinances-host-router",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_STORE",
        "class_name": "AuthStore"
      }
    ]
  },
  "exports": {
    "AuthStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "assets": {
    "directory": "../sites",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "AUTH_EMAIL_FROM": "noreply@dofinances.com",
    "COLOSSEUM_ACCESS_ISSUER": "https://luke-inc.cloudflareaccess.com",
    "CLOUDFLARE_CONNECTION_ACCESS_AUD": "92e47cfd0af16da882598d859617f518ce66276fde45e33fdd6be69a42aad593",
    "COLOSSEUM_ACCESS_AUD": "a219b092a0fad93c9cac89fa2881f15116e9b4e9fbc4c0402161d013112f2014"
  },
  "keep_vars": true,
  "services": [
    {
      "binding": "LIBRARY_III",
      "service": "library-iii"
    },
    {
      "binding": "COLOSSEUM_ROUTER",
      "service": "router"
    }
  ]
}
