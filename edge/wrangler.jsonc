{
  "name": "dofinances-host-router",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "../sites",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
